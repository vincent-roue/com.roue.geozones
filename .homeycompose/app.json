{
  "id": "com.roue.geozones",
  "version": "2.0.6",
  "sdk": 3,
  "compatibility": ">=12.5.0",
  "platforms": [
    "local"
  ],
  "brandColor": "#2F6FED",
  "name": {
    "en": "GeoZones",
    "fr": "GeoZones",
    "nl": "GeoZones",
    "de": "GeoZones"
  },
  "description": {
    "en": "Use geographic zones in your Flows",
    "fr": "Utilisez vos zones géographiques dans les Flows",
    "nl": "Gebruik geografische zones in je Flows",
    "de": "Geografische Zonen in Flows verwenden"
  },
  "category": "tools",
  "author": {
    "name": "Vincent Roué"
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "api": {
    "getMeta": {
      "method": "GET",
      "path": "/meta"
    },
    "getConfig": {
      "method": "GET",
      "path": "/config"
    },
    "setConfig": {
      "method": "PUT",
      "path": "/config"
    },
    "mergeConfig": {
      "method": "POST",
      "path": "/config/merge"
    },
    "evaluateCoordinates": {
      "method": "POST",
      "path": "/evaluate/coordinates"
    },
    "getHistory": {
      "method": "GET",
      "path": "/history"
    },
    "restoreHistory": {
      "method": "POST",
      "path": "/history/:id/restore"
    },
    "deleteHistory": {
      "method": "DELETE",
      "path": "/history/:id"
    },
    "getMigrationStatus": {
      "method": "GET",
      "path": "/migration/status"
    },
    "getMigrationBackup": {
      "method": "GET",
      "path": "/migration/backup"
    }
  },
  "homepage": "https://github.com/vincent-roue/com.roue.geozones",
  "source": "https://github.com/vincent-roue/com.roue.geozones",
  "homeyCommunityTopicId": 153017,
  "support": "https://community.homey.app/t/app-pro-geozones/153017",
  "bugs": {
    "url": "https://community.homey.app/t/app-pro-geozones/153017"
  },
  "tags": {
    "en": [
      "geofencing",
      "location",
      "zones",
      "presence",
      "gps"
    ],
    "fr": [
      "géolocalisation",
      "localisation",
      "zones",
      "présence",
      "gps"
    ],
    "nl": [
      "geofencing",
      "locatie",
      "zones",
      "aanwezigheid",
      "gps"
    ],
    "de": [
      "geofencing",
      "standort",
      "zonen",
      "anwesenheit",
      "gps"
    ]
  },
  "runtime": "nodejs",
  "permissions": [
    "homey:manager:geolocation"
  ],
  "drivers": [
    {
      "id": "subject_manual"
    }
  ]
}
